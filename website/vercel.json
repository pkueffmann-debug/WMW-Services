{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/brain",            "destination": "/api/brain" },
    { "source": "/brain/",           "destination": "/api/brain" },
    { "source": "/brain/dashboard",  "destination": "/api/brain/dashboard" },
    { "source": "/brain/dashboard/", "destination": "/api/brain/dashboard" },
    { "source": "/brain/tasks",      "destination": "/api/brain/tasks-page" },
    { "source": "/brain/tasks/",     "destination": "/api/brain/tasks-page" }
  ],
  "functions": {
    "api/brain.js": {
      "includeFiles": "api/_lib/brain.html"
    },
    "api/brain/dashboard.js": {
      "includeFiles": "api/_lib/dashboard.html"
    },
    "api/brain/tasks-page.js": {
      "includeFiles": "api/_lib/tasks.html"
    }
  }
}
